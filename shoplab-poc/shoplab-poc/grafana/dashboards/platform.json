    {
      "type": "timeseries",
      "title": "Ações dos utilizadores",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(ts) AS time,\n  countIf(event = 'view_product') AS `Ver produto`,\n  countIf(event = 'search') AS Pesquisa,\n  countIf(event = 'add_to_cart') AS Carrinho,\n  countIf(event = 'checkout_started') AS Checkout,\n  countIf(event = 'purchase') AS Compra,\n  countIf(event = 'signup') AS Registo\nFROM platform.user_events WHERE $__timeFilter(ts) GROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "drawStyle": "line",
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11
    },
    {
      "type": "bargauge",
      "title": "Funil de conversão (sessões)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 6,
        "h": 8
      },
      "description": "Sessões que chegaram a cada etapa da compra",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  uniqIf(session_id, event = 'view_product') AS `1. Viram produtos`,\n  uniqIf(session_id, event = 'add_to_cart') AS `2. Adicionaram ao carrinho`,\n  uniqIf(session_id, event = 'checkout_started') AS `3. Iniciaram checkout`,\n  uniqIf(session_id, event = 'purchase') AS `4. Compraram`\nFROM platform.user_events WHERE $__timeFilter(ts)",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 12
    },
