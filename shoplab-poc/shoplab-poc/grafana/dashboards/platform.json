      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT route AS Rota, count() AS Pedidos,\n  round(100 * countIf(status >= 500) / count(), 2) AS `Erro 5xx %`,\n  countIf(status >= 400 AND status < 500) AS `4xx`,\n  countIf(status = 504) AS Timeouts,\n  round(quantile(0.95)(duration_ms)) AS `p95 ms`\nFROM platform.http_requests WHERE $__timeFilter(ts) GROUP BY route ORDER BY Pedidos DESC",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
