          "editorType": "sql",
          "rawSql": "SELECT country AS `País`, uniq(session_id) AS `Sessões`\nFROM platform.http_requests WHERE $__timeFilter(ts) GROUP BY country ORDER BY `Sessões` DESC LIMIT 10",
