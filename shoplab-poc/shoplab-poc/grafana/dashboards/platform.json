            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT round(100 * countIf(status >= 500) / greatest(count(), 1), 2) AS `Erro 5xx` FROM platform.http_requests WHERE $__timeFilter(ts)",
