            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(ts) AS time,\n  countIf(error_type = 'upstream_timeout') AS `Gateway de pagamento`,\n  countIf(error_type = 'query_timeout') AS `Motor de pesquisa`\nFROM platform.http_requests WHERE $__timeFilter(ts) GROUP BY time ORDER BY time",
