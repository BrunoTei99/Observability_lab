      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(ts) AS time,\n  countIf(error_type = 'internal_error') AS `Erro interno`,\n  countIf(error_type = 'db_error') AS `Erro BD`,\n  countIf(error_type = 'db_unavailable') AS `BD indisponível`,\n  countIf(error_type = 'upstream_timeout') AS `Timeout pagamento`,\n  countIf(error_type = 'query_timeout') AS `Timeout pesquisa`,\n  countIf(error_type = 'payment_declined') AS `Pagamento recusado`,\n  countIf(error_type = 'not_found') AS `Não encontrado`,\n  countIf(error_type = 'invalid_credentials') AS `Login falhado`,\n  countIf(error_type = 'not_authenticated') AS `Sem sessão`\nFROM platform.http_requests WHERE $__timeFilter(ts) GROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
