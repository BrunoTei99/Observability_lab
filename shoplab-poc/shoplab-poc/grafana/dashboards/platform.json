          "rawSql": "SELECT $__timeInterval(ts) AS time,\n  uniqIf(session_id, session_id != '') AS `Sessões ativas`,\n  uniqIf(user_id, user_id > 0) AS `Utilizadores autenticados`\nFROM platform.http_requests WHERE $__timeFilter(ts) GROUP BY time ORDER BY time",
